{
  "name": "agent-auto-update-dashboard",
  "version": "0.13.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "dev:all": "node scripts/dev-all.js",
    "build:client": "npm --prefix client run build",
    "check:refs": "node scripts/check-client-refs.mjs client/src",
    "check:i18n": "node scripts/check-i18n.mjs client/src",
    "check:install": "node scripts/check-install-scripts.mjs",
    "check:client": "npm run --silent check:refs && npm run --silent check:i18n && npm run --silent check:install",
    "gen:release": "node scripts/generate-release-md.mjs",
    "check:release": "node scripts/generate-release-md.mjs --check",
    "test:security": "node server/utils/command-policy.test.js",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.12.0",
    "adm-zip": "^0.5.16",
    "bcrypt": "^5.1.1",
    "connect-sqlite3": "^0.9.13",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "multer": "^2.0.2",
    "node-pty": "^1.1.0",
    "nodemailer": "^8.0.11",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1",
    "ws": "^8.19.0"
  }
}
