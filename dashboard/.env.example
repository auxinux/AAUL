# Dashboard overrides
HOST=0.0.0.0
PORT=3001
BASE_URL=http://127.0.0.1:3001
DB_PATH=./dashboard.sqlite
# Laisser vide : un secret aléatoire persistant est généré automatiquement
# (stocké en 0600 dans .session-secret). Ne définir que pour un déploiement
# multi-instances qui doit partager le même secret de session.
SESSION_SECRET=
SESSION_SECURE=false
ALLOW_HTTP_INSTALL=false
# Proxys autorises a fournir X-Forwarded-For / X-Forwarded-Proto.
# Par defaut : un reverse proxy sur cette meme machine (loopback).
# Proxy sur une autre machine : son adresse ou son sous-reseau, ex. 10.0.0.5
# ou 10.0.0.0/24 (liste separee par des virgules). "false" : aucun proxy.
TRUST_PROXY=
AGENT_DEFAULT_POLL_SECONDS=15
AGENT_DEFAULT_SCHEDULE_ENABLED=0
AGENT_DEFAULT_DAILY_TIME=03:00
AGENT_AUTO_UPDATE_ENABLED=true
LOG_LEVEL=info
