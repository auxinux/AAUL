node_modules/

# Local runtime data (created automatically at first launch)
dashboard/dashboard.sqlite
dashboard/dashboard.sessions.sqlite
dashboard/.session-secret
dashboard/.data-protection-key
dashboard/.release-notes-cache.md
dashboard/.initial-admin-password
dashboard/ssl/
dashboard/server/ssl/*.key
dashboard/server/ssl/*.crt
dashboard/server/ssl/*.pem

# Env overrides (copy from .env.example)
dashboard/.env
dashboard/client/.env

# Build output
dashboard/client/dist/
dashboard/public/agent/*.tar.gz
dashboard/public/agent/VERSION
# dashboard/public/agent/windows/aaul-agent.exe is deliberately NOT ignored.
# The Python bundle is rebuilt from tracked sources on any host; the Go binary
# needs a toolchain a dashboard server has no reason to carry, so it ships in
# the repository and reaches production through git pull.
release/

# Logs
*.log
npm-debug.log*

# Python bytecode (the Linux/macOS agent)
__pycache__/
*.pyc

# Editor/OS cruft
.DS_Store
.vscode/
.idea/
.claude/settings.local.json
